# Cấu hình SMTP gửi mail qua Gmail cho EPM Courses Hub
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=khuongnd.areteepm@gmail.com

# Nhập 16 ký tự Mật khẩu ứng dụng (App Password) từ tài khoản Gmail của bạn vào đây
# Hướng dẫn lấy Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=

# Trên Render, gắn Persistent Disk tại /var/data rồi đặt DATA_DIR=/var/data.
# Mỗi lần dữ liệu thay đổi, ứng dụng giữ 30 snapshot gần nhất theo mặc định.
DATA_DIR=
BACKUP_DIR=
BACKUP_RETENTION=30
